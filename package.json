{
  "name": "nextjs-sandbox",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.11.1",
    "npm": "Use pnpm instead of npm for this project.",
    "yarn": "Use pnpm instead of yarn for this project.",
    "pnpm": "8.15.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --coverage",
    "check": "run-s check:*",
    "check:format": "prettier \"./src/**/*.{ts,tsx}\" --check",
    "check:format-config": "prettier \"./*.{js,mjs,ts,json}\" \"./configs/**/*.js\" \"./.storybook/*.ts\" --check",
    "check:lint-css": "stylelint \"./src/**/*.{ts,tsx}\"",
    "check:lint-js": "eslint \"./src/components/Button/Button.tsx\"",
    "check:spell": "cspell \"./src/**/*.{ts,tsx}\"",
    "check:spell-config": "cspell \"./*.{js,mjs,ts,json}\" \"./configs/**/*.js\" \"./.storybook/*.ts\"",
    "fix": "run-s fix:*",
    "fix:format": "prettier \"./src/**/*.{ts,tsx}\" --write",
    "fix:format-config": "prettier \"./*.{js,mjs,ts,json}\" \"./configs/**/*.{js,mjs}\" \"./.storybook/*.ts\" --write",
    "fix:lint-css": "stylelint \"./src/**/*.{ts,tsx}\" --fix",
    "fix:lint-js": "eslint \"./src/**/*.{ts,tsx}\" --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "14.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "6.1.11",
    "the-new-css-reset": "1.11.2",
    "typescript": "5.5.2",
    "typescript-eslint": "7.14.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.1.11",
    "@storybook/addon-docs": "8.1.11",
    "@storybook/addon-essentials": "8.1.11",
    "@storybook/addon-interactions": "8.1.11",
    "@storybook/addon-links": "8.1.11",
    "@storybook/addon-themes": "8.1.11",
    "@storybook/blocks": "8.1.11",
    "@storybook/nextjs": "8.1.11",
    "@storybook/react": "8.1.11",
    "@storybook/test": "8.1.11",
    "@swc/core": "1.6.5",
    "@swc/jest": "0.2.36",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.0.0",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/styled-components": "5.1.34",
    "cspell": "8.9.1",
    "eslint": "9.5.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-next": "14.2.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "28.6.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-sonarjs": "1.0.3",
    "eslint-plugin-storybook": "0.8.0",
    "eslint-plugin-strict-dependencies": "1.3.7",
    "eslint-plugin-testing-library": "6.2.2",
    "eslint-plugin-tsdoc": "0.3.0",
    "eslint-plugin-unicorn": "54.0.0",
    "globals": "15.6.0",
    "jest": "29.7.0",
    "jest-styled-components": "7.2.0",
    "npm-run-all": "4.1.5",
    "postcss-styled-syntax": "0.6.4",
    "prettier": "3.3.2",
    "storybook": "8.1.11",
    "stylelint": "16.6.1",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-standard": "36.0.1",
    "stylelint-config-styled-components": "0.1.1",
    "stylelint-declaration-block-no-ignored-properties": "2.8.0",
    "stylelint-no-unsupported-browser-features": "8.0.1",
    "stylelint-order": "6.0.4"
  }
}
