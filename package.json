{
  "name": "sandbox-nextjs",
  "version": "0.1.0",
  "description": "Next.js のプロジェクトのひな形",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "pnpm check:format && pnpm check:lint-js && pnpm check:lint-css && pnpm check:spell",
    "check:format": "prettier --check .",
    "check:lint-js": "eslint .",
    "check:lint-css": "stylelint \"src/**/*.styled.ts\" \"src/shared/styles/**/*.tsx\"",
    "check:spell": "cspell --no-progress \"**/*.{ts,tsx,mjs,json}\"",
    "fix": "pnpm fix:lint-js && pnpm fix:lint-css && pnpm fix:format",
    "fix:format": "prettier --write .",
    "fix:lint-js": "eslint --fix .",
    "fix:lint-css": "stylelint --fix \"src/**/*.styled.ts\" \"src/shared/styles/**/*.tsx\"",
    "storybook": "storybook dev --port 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/nextjs": "10.6.8",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cspell": "10.5.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jest": "29.17.1",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.8",
    "eslint-plugin-strict-dependencies": "2.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-styled-components": "7.4.1",
    "postcss-styled-syntax": "0.7.4",
    "prettier": "3.10.1",
    "storybook": "10.6.8",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-order": "8.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
