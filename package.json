{
  "name": "sandbox-nextjs",
  "version": "0.1.0",
  "description": "Next.js のプロジェクトのひな形",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm check:biome && pnpm check:spell",
    "check:biome": "biome check --error-on-warnings .",
    "check:spell": "cspell --no-progress --dot \"**/*.{ts,tsx,mjs,mts,json,css}\"",
    "fix": "biome check --write .",
    "storybook": "storybook dev --port 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/nextjs-vite": "10.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "cspell": "10.5.2",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
